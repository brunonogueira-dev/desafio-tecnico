# Copie para `.env` e ajuste os valores. O `.env` real não é versionado.

# === PostgreSQL ===
# Credenciais do banco. O compose usa estes valores para subir o Postgres
# e para montar a connection string da API.
POSTGRES_USER=onibus
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=onibus_express
# Porta exposta no host (o container sempre escuta em 5432 internamente).
POSTGRES_PORT=5432

# === API ===
# Em Development a API aplica migrations + seed no startup.
ASPNETCORE_ENVIRONMENT=Development
# Porta exposta no host para a API.
API_PORT=8080
# Origens liberadas no CORS (frontend).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# === Frontend ===
# Porta exposta no host para o frontend (nginx).
WEB_PORT=3000
# URL pública da API que o frontend consome (injetada em runtime no nginx).
API_BASE_URL=http://localhost:8080
